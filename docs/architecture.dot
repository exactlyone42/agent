digraph Agent {
 graph [rankdir=TB, bgcolor="#f7f9fc", pad="0.35", nodesep="0.35", ranksep="0.6", fontname="Noto Sans CJK TC", label="目標架構｜產品元件待實作", labelloc=t, fontsize=22];
 node [shape=box, style="rounded,filled", fillcolor=white, color="#486581", fontname="Noto Sans CJK TC", fontsize=14, margin="0.18,0.12"];
 edge [fontname="Noto Sans CJK TC", fontsize=11, color="#486581"];
 user [label="使用者"];
 subgraph cluster_agent {
  label="agent-platform｜獨立 Repo"; color="#93b4d5"; style=rounded;
  ui [label="Tauri 桌面 Client\n任務・差異・授權・停止"];
  harness [label="Agent 執行程式（Harness）\n工具迴圈・上下文・接續"];
  tools [label="工具與授權\nMCP・隔離執行"];
  knowledge [label="Knowledge API\n知識庫・RAG・引用"];
  memory [label="Memory API\n同意・來源・更新"];
  computer [label="Computer Use API\n觀察・操作・驗證・停止"];
  storage [label="PostgreSQL / pgvector\n任務事件・知識・記憶"];
  eval [label="Evaluation / 錯誤注入\n建立測試環境・獨立驗證結果",fillcolor="#fff1d6"];
 }
 gateway [label="既有 Gateway｜另一 Repo\n模型 API・路由・Provider 憑證",fillcolor="#e4f2e8"];
 drivers [label="現成工具 / 電腦驅動\n隔離測試環境"];
 other [label="其他產品 / 外部實作者"];
 user -> ui [label="交代任務 / 決定授權"];
 ui -> harness [label="開始・查進度・停止",dir=both];
 harness -> gateway [label="模型請求 / 回應",dir=both];
 harness -> tools [label="工具呼叫 / 結果",dir=both];
 tools -> knowledge [dir=both];tools -> memory [dir=both];tools -> computer [dir=both];
 harness -> storage [label="事件 / 恢復",dir=both];knowledge -> storage [dir=both];memory -> storage [dir=both];
 computer -> drivers [label="操作 / 新觀察",dir=both];
 other -> knowledge [label="獨立 API"];other -> computer [label="可替換實作"];
 eval -> harness [style=dashed,label="固定任務與故障"];
 eval -> drivers [style=dashed,label="驗檔案與實際狀態"];
}
